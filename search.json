---
layout: null
permalink: /search.json
---
[{% for post in site.posts %}{"title":{{ post.title | jsonify }},"url":{{ post.url | relative_url | jsonify }},"date":{{ post.date | date: '%d %b %Y' | jsonify }},"description":{{ post.description | default: post.excerpt | strip_html | strip | jsonify }},"content":{{ post.content | strip_html | strip | jsonify }},"categories":{{ post.categories | jsonify }},"tags":{{ post.tags | jsonify }}}{% unless forloop.last %},{% endunless %}{% endfor %}]
